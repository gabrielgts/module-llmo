<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- DTO preferences -->
    <preference for="Gtstudio\Llmo\Api\Data\AiFeedInterface"
                type="Gtstudio\Llmo\Model\Feed\AiFeed"/>
    <preference for="Gtstudio\Llmo\Api\Data\AiFeedItemInterface"
                type="Gtstudio\Llmo\Model\Feed\AiFeedItem"/>

    <!-- Validator DTO preferences -->
    <preference for="Gtstudio\Llmo\Api\Data\ValidationIssueInterface"
                type="Gtstudio\Llmo\Model\Validator\ValidationIssue"/>
    <preference for="Gtstudio\Llmo\Api\Data\ValidationResultInterface"
                type="Gtstudio\Llmo\Model\Validator\ValidationResult"/>

    <!-- Validator implementation preferences -->
    <preference for="Gtstudio\Llmo\Api\Validator\SchemaValidatorInterface"
                type="Gtstudio\Llmo\Model\Validator\AcpSchemaValidator"/>
    <preference for="Gtstudio\Llmo\Api\Validator\QualityValidatorInterface"
                type="Gtstudio\Llmo\Model\Validator\QualityValidator"/>

    <!-- Campaign DTO preference -->
    <preference for="Gtstudio\Llmo\Api\Data\CampaignInterface"
                type="Gtstudio\Llmo\Model\Campaign"/>

    <!-- Dashboard snapshot DTO preference -->
    <preference for="Gtstudio\Llmo\Api\Data\LlmoSnapshotInterface"
                type="Gtstudio\Llmo\Model\Dashboard\LlmoSnapshot"/>

    <!-- REST API preferences -->
    <preference for="Gtstudio\Llmo\Api\GetFeedInterface"
                type="Gtstudio\Llmo\Model\Api\GetFeed"/>
    <preference for="Gtstudio\Llmo\Api\ValidateFeedInterface"
                type="Gtstudio\Llmo\Model\Api\ValidateFeed"/>

    <!-- AcpSchemaValidator needs the native filesystem driver to locate the bundled schema -->
    <type name="Gtstudio\Llmo\Model\Validator\AcpSchemaValidator">
        <arguments>
            <argument name="filesystemDriver" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>

    <!-- robots.txt enrichment: append AI directives to Magento\Robots\Model\Robots::getData() -->
    <type name="Magento\Robots\Model\Robots">
        <plugin name="gtstudio_llmo_robots_ai_directives"
                type="Gtstudio\Llmo\Plugin\Robots\AfterGetData"/>
    </type>

    <!-- Frontend AI-crawler hit logging on every dispatch -->
    <type name="Magento\Framework\App\FrontController">
        <plugin name="gtstudio_llmo_record_crawler_hit"
                type="Gtstudio\Llmo\Plugin\Front\RecordCrawlerHit"/>
    </type>

    <!-- Exporter registry — register new targets here as they ship -->
    <type name="Gtstudio\Llmo\Model\Feed\ExporterPool">
        <arguments>
            <argument name="exporters" xsi:type="array">
                <item name="acp" xsi:type="object">Gtstudio\Llmo\Model\Feed\Exporter\AcpExporter</item>
            </argument>
        </arguments>
    </type>

</config>
