<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="gtstudio_llmo_rebuild_feed"
             instance="Gtstudio\Llmo\Cron\RebuildFeed"
             method="execute">
            <config_path>llmo/feed/rebuild_schedule</config_path>
        </job>

        <job name="gtstudio_llmo_build_dashboard"
             instance="Gtstudio\Llmo\Cron\BuildLlmoDashboard"
             method="execute">
            <config_path>llmo/dashboard/rebuild_schedule</config_path>
        </job>
    </group>
</config>
