<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/llmo/feed" method="GET">
        <service class="Gtstudio\Llmo\Api\GetFeedInterface" method="execute"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/llmo/feed/validate" method="POST">
        <service class="Gtstudio\Llmo\Api\ValidateFeedInterface" method="execute"/>
        <resources>
            <resource ref="Gtstudio_Llmo::validation"/>
        </resources>
    </route>
</routes>
