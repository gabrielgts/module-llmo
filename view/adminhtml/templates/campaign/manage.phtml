                    <?= $escaper->escapeHtml(__('Exporter')) ?>
                </label>
                <select id="llmo-campaign-exporter" name="exporter_code" class="admin__control-select">
                    <?php foreach ($exporters as $exporter): ?>
                        <option value="<?= $escaper->escapeHtmlAttr($exporter->code()) ?>">
