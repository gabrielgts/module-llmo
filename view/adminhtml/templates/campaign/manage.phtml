            <div class="admin__field">
                <label class="admin__field-label" for="llmo-campaign-active">
                    <?= $escaper->escapeHtml(__('Active')) ?>
                </label>
                <input type="checkbox" id="llmo-campaign-active" name="is_active" value="1" checked="checked"/>
            </div>
            <button type="submit" class="action-primary">
                <?= $escaper->escapeHtml(__('Save campaign')) ?>
            </button>
        </form>
