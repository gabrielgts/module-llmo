                                <input type="hidden" name="form_key"
                                       value="<?= $escaper->escapeHtml($block->getFormKey()) ?>"/>
                                <input type="hidden" name="campaign_id"
                                       value="<?= (int) $campaign->getCampaignId() ?>"/>
                                <button type="submit" class="action-secondary">
                                    <?= $escaper->escapeHtml(__('Delete')) ?>
                                </button>
                            </form>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    </div>
</div>
