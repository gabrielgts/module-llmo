            <p><?= $escaper->escapeHtml(__('No campaigns yet.')) ?></p>
        <?php else: ?>
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>#</th>
                        <th><?= $escaper->escapeHtml(__('Code')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Name')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Exporter')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Target URL')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Active')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Last Run')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Last Status')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Actions')) ?></th>
                    </tr>
                </thead>
                <tbody>
                <?php foreach ($campaigns as $campaign): ?>
                    <tr>
                        <td><?= (int) $campaign->getCampaignId() ?></td>
                        <td><code><?= $escaper->escapeHtml($campaign->getCode()) ?></code></td>
                        <td><?= $escaper->escapeHtml($campaign->getName()) ?></td>
                        <td><code><?= $escaper->escapeHtml($campaign->getExporterCode()) ?></code></td>
                        <td><?= $escaper->escapeHtml((string) ($campaign->getTargetUrl() ?? '')) ?></td>
                        <td>
                            <?= $campaign->isActive()
                                ? $escaper->escapeHtml(__('yes'))
                                : $escaper->escapeHtml(__('no')) ?>
                        </td>
                        <td><?= $escaper->escapeHtml((string) ($campaign->getLastRunAt() ?? '—')) ?></td>
                        <td>
                            <?= $escaper->escapeHtml((string) ($campaign->getLastStatus() ?? '—')) ?>
