?>
<div class="llmo-campaign">
    <div class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__('Create campaign')) ?></span>
        </div>
        <form action="<?= $escaper->escapeUrl($block->getSaveUrl()) ?>" method="post">
            <input type="hidden" name="form_key"
                   value="<?= $escaper->escapeHtml($block->getFormKey()) ?>"/>
            <div class="admin__field">
                <label class="admin__field-label" for="llmo-campaign-code">
                    <?= $escaper->escapeHtml(__('Code')) ?>
                </label>
                <input type="text" id="llmo-campaign-code" name="code"
